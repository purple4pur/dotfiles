#!/usr/bin/env bash

# Install nvim-terminal beside this script; this entry point may be linked as nvim.
script_dir=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
launcher="$script_dir/nvim-terminal"
[[ -f "$launcher" ]] || launcher="$script_dir/executable_nvim-terminal"
exec bash "$launcher" xfce4 "$@"
